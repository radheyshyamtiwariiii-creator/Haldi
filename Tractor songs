<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kisan Swaraj - Indian Village Tractor Cockpit Simulator</title>
    <!-- GSAP for Ultra-smooth Animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <!-- FontAwesome & Google Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Rozha+One&family=Outfit:wght@300;400;600;800&family=Teko:wght@500;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            /* State Themes Palette Defaults (Punjab Wheat) */
            --sky-top: #1A0B2E;
            --sky-bottom: #F7941E;
            --sun-color: #FFD166;
            --soil-color: #522719;
            --crop-color: #E29578;
            --accent-gold: #FFB703;
            --primary-red: #D62828;
            --hud-glass: rgba(15, 23, 42, 0.75);
            --hud-border: rgba(255, 255, 255, 0.15);
            --glow-color: #FFB703;
            --font-head: 'Teko', sans-serif;
            --font-deva: 'Rozha One', serif;
            --font-body: 'Outfit', sans-serif;
        }

        /* State Theme Variations */
        [data-theme="punjab"] {
            --sky-top: #0d1b2a;
            --sky-bottom: #f4a261;
            --sun-color: #ffb703;
            --soil-color: #3d1c02;
            --crop-color: #e9c46a;
            --accent-gold: #fb8500;
            --glow-color: #fb8500;
        }

        [data-theme="rajasthan"] {
            --sky-top: #2b1e3a;
            --sky-bottom: #e76f51;
            --sun-color: #fcbf49;
            --soil-color: #6b3e26;
            --crop-color: #d4a373;
            --accent-gold: #f4a261;
            --glow-color: #e76f51;
        }

        [data-theme="kerala"] {
            --sky-top: #022c22;
            --sky-bottom: #10b981;
            --sun-color: #fef08a;
            --soil-color: #14532d;
            --crop-color: #22c55e;
            --accent-gold: #34d399;
            --glow-color: #10b981;
        }

        [data-theme="up"] {
            --sky-top: #1e1b4b;
            --sky-bottom: #c084fc;
            --sun-color: #fde047;
            --soil-color: #4a1d96;
            --crop-color: #a855f7;
            --accent-gold: #e879f9;
            --glow-color: #c084fc;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: var(--font-body);
            background: #000;
            color: #fff;
        }

        /* Ambient Canvas & Parallax Environment */
        #viewport {
            position: relative;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-bottom) 60%, var(--soil-color) 100%);
            transition: background 1.2s ease-in-out;
        }

        .layer {
            position: absolute;
            width: 110%;
            height: 110%;
            top: -5%;
            left: -5%;
            pointer-events: none;
            transition: transform 0.1s ease-out;
        }

        /* Celestial Body */
        .sun {
            position: absolute;
            top: 20%;
            left: 50%;
            transform: translateX(-50%);
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--sun-color) 30%, rgba(255,255,255,0) 70%);
            box-shadow: 0 0 80px var(--sun-color);
            transition: background 1s ease, box-shadow 1s ease;
            filter: blur(2px);
        }

        /* Distant Village Silhouette */
        .silhouette {
            position: absolute;
            bottom: 35%;
            width: 100%;
            height: 120px;
            background-repeat: repeat-x;
            background-position: bottom;
            opacity: 0.35;
        }

        /* Crops / Field Dynamic Layer */
        .farm-fields {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 45%;
            background: linear-gradient(0deg, var(--soil-color) 0%, transparent 100%);
            perspective: 600px;
        }

        .furrows {
            position: absolute;
            width: 200%;
            height: 200%;
            top: -50%;
            left: -50%;
            background: repeating-linear-gradient(
                90deg,
                rgba(0, 0, 0, 0.4) 0px,
                rgba(0, 0, 0, 0.4) 20px,
                transparent 20px,
                transparent 60px
            );
            transform: rotateX(75deg);
            animation: moveFurrows 2s linear infinite;
            animation-play-state: paused;
        }

        @keyframes moveFurrows {
            0% { transform: rotateX(75deg) translateY(0); }
            100% { transform: rotateX(75deg) translateY(60px); }
        }

        /* Heat Haze Overlay */
        .heat-haze {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle, transparent 60%, rgba(0,0,0,0.6) 100%);
            pointer-events: none;
            z-index: 2;
        }

        /* Central Cockpit View / Hood */
        .cockpit-container {
            position: absolute;
            bottom: -50px;
            left: 50%;
            transform: translateX(-50%);
            width: 1000px;
            max-width: 95vw;
            height: 60vh;
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
        }

        /* Exhaust Pipe & Smoke */
        .exhaust-stack {
            position: absolute;
            top: -60px;
            right: 220px;
            width: 24px;
            height: 140px;
            background: linear-gradient(90deg, #111, #444, #222);
            border-radius: 4px 4px 0 0;
            box-shadow: inset 0 0 10px #000;
        }

        .smoke-particle {
            position: absolute;
            top: -10px;
            right: 222px;
            width: 20px;
            height: 20px;
            background: rgba(200, 200, 200, 0.4);
            border-radius: 50%;
            filter: blur(8px);
            pointer-events: none;
            opacity: 0;
        }

        /* Tractor Hood Graphic (SVG Driven) */
        .tractor-body {
            width: 100%;
            height: 320px;
            position: relative;
            filter: drop-shadow(0px -10px 30px rgba(0,0,0,0.8));
            transition: transform 0.05s ease-out;
        }

        .hood-svg {
            width: 100%;
            height: 100%;
        }

        /* HUD Glassmorphism Dashboard */
        .hud-dashboard {
            position: absolute;
            bottom: 20px;
            width: 92%;
            background: var(--hud-glass);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--hud-border);
            border-radius: 24px;
            padding: 20px 30px;
            display: grid;
            grid-template-columns: 1.2fr 2fr 1.2fr;
            gap: 20px;
            align-items: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.2);
            z-index: 10;
        }

        /* Top Navigation Header Bar */
        .top-bar {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 20;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--hud-glass);
            padding: 10px 20px;
            border-radius: 50px;
            border: 1px solid var(--hud-border);
            backdrop-filter: blur(10px);
        }

        .brand-logo h1 {
            font-family: var(--font-deva);
            font-size: 1.6rem;
            color: var(--accent-gold);
            letter-spacing: 1px;
        }

        .brand-logo span {
            font-family: var(--font-head);
            font-size: 1.2rem;
            letter-spacing: 2px;
            color: #ccc;
        }

        /* Controls Panel Top Right */
        .selector-group {
            display: flex;
            gap: 15px;
        }

        .glass-select {
            background: var(--hud-glass);
            color: #fff;
            border: 1px solid var(--hud-border);
            padding: 10px 18px;
            border-radius: 30px;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.9rem;
            outline: none;
            cursor: pointer;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .glass-select:hover {
            border-color: var(--accent-gold);
            box-shadow: 0 0 15px var(--glow-color);
        }

        .glass-select option {
            background: #111827;
            color: #fff;
        }

        /* Dashboard Gauge Gauges Section */
        .gauge-cluster {
            display: flex;
            justify-content: space-around;
            align-items: center;
        }

        .gauge-card {
            position: relative;
            width: 110px;
            height: 110px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .gauge-svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

        .gauge-bg {
            fill: none;
            stroke: rgba(255, 255, 255, 0.1);
            stroke-width: 8;
        }

        .gauge-val {
            fill: none;
            stroke: var(--accent-gold);
            stroke-width: 8;
            stroke-dasharray: 283;
            stroke-dashoffset: 283;
            transition: stroke-dashoffset 0.1s linear, stroke 0.3s;
            stroke-linecap: round;
        }

        .gauge-center {
            position: absolute;
            text-align: center;
        }

        .gauge-num {
            font-family: var(--font-head);
            font-size: 1.8rem;
            line-height: 1;
            font-weight: 700;
            color: #fff;
        }

        .gauge-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #aaa;
        }

        /* Central Ignition & Steering Controls */
        .center-controls {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        .ignition-btn {
            position: relative;
            width: 85px;
            height: 85px;
            border-radius: 50%;
            background: radial-gradient(circle, #333, #111);
            border: 4px solid #444;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(0,0,0,0.8), inset 0 2px 5px rgba(255,255,255,0.2);
            transition: all 0.2s ease;
        }

        .ignition-btn::after {
            content: '';
            position: absolute;
            inset: 6px;
            border-radius: 50%;
            border: 2px dashed rgba(255,255,255,0.2);
        }

        .ignition-btn.active {
            border-color: #22c55e;
            box-shadow: 0 0 30px #22c55e;
        }

        .ignition-icon {
            font-size: 2rem;
            color: #ef4444;
            transition: color 0.3s ease;
        }

        .ignition-btn.active .ignition-icon {
            color: #22c55e;
            text-shadow: 0 0 10px #22c55e;
        }

        .action-btns {
            display: flex;
            gap: 15px;
        }

        .btn-action {
            background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.05));
            border: 1px solid var(--hud-border);
            padding: 10px 20px;
            border-radius: 12px;
            color: #fff;
            font-family: var(--font-head);
            font-size: 1.2rem;
            letter-spacing: 1px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

        .btn-action:hover {
            background: var(--accent-gold);
            color: #000;
            box-shadow: 0 0 15px var(--accent-gold);
            transform: translateY(-2px);
        }

        .btn-action:active {
            transform: translateY(1px);
        }

        /* Glassmorphism Music Player Panel */
        .music-player-card {
            position: absolute;
            right: 20px;
            top: 90px;
            width: 320px;
            background: var(--hud-glass);
            backdrop-filter: blur(20px);
            border: 1px solid var(--hud-border);
            border-radius: 20px;
            padding: 20px;
            z-index: 15;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            transition: transform 0.4s ease;
        }

        .player-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .player-header h3 {
            font-family: var(--font-head);
            font-size: 1.3rem;
            letter-spacing: 1px;
            color: var(--accent-gold);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .track-info {
            margin-bottom: 15px;
        }

        .track-title {
            font-weight: 600;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .track-artist {
            font-size: 0.75rem;
            color: #aaa;
        }

        .progress-area {
            width: 100%;
            height: 6px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            cursor: pointer;
            position: relative;
            margin-bottom: 15px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: var(--accent-gold);
            border-radius: 10px;
            position: relative;
        }

        .player-controls {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
        }

        .control-btn {
            background: none;
            border: none;
            color: #fff;
            font-size: 1.2rem;
            cursor: pointer;
            transition: color 0.2s, transform 0.2s;
        }

        .control-btn:hover {
            color: var(--accent-gold);
            transform: scale(1.15);
        }

        .play-btn {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--accent-gold);
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 0 15px var(--glow-color);
        }

        .play-btn:hover {
            color: #000;
            transform: scale(1.08);
        }

        .playlist-box {
            max-height: 110px;
            overflow-y: auto;
            margin-top: 15px;
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 10px;
        }

        .playlist-box::-webkit-scrollbar {
            width: 4px;
        }

        .playlist-box::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.2);
            border-radius: 4px;
        }

        .playlist-item {
            padding: 6px 10px;
            font-size: 0.8rem;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            transition: background 0.2s;
        }

        .playlist-item:hover, .playlist-item.active {
            background: rgba(255,255,255,0.1);
            color: var(--accent-gold);
        }

        /* Nostalgic Village Quotes Overlay */
        .quote-container {
            position: absolute;
            top: 100px;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            z-index: 10;
            width: 80%;
            max-width: 650px;
            pointer-events: none;
        }

        .quote-text {
            font-family: var(--font-deva);
            font-size: 1.6rem;
            color: #fff;
            text-shadow: 0 4px 20px rgba(0,0,0,0.9);
            opacity: 0;
            transition: opacity 1s ease, transform 1s ease;
            transform: translateY(10px);
        }

        .quote-sub {
            font-family: var(--font-body);
            font-size: 0.85rem;
            letter-spacing: 3px;
            color: var(--accent-gold);
            text-transform: uppercase;
            margin-top: 6px;
            opacity: 0;
            transition: opacity 1s ease 0.3s;
        }

        /* Village Atmosphere Particles */
        .dust-particle {
            position: absolute;
            background: rgba(255, 235, 170, 0.6);
            border-radius: 50%;
            pointer-events: none;
            z-index: 3;
        }

        /* Responsive Breakpoints */
        @media (max-width: 900px) {
            .hud-dashboard {
                grid-template-columns: 1fr;
                gap: 15px;
                padding: 15px;
                bottom: 10px;
            }
            .music-player-card {
                top: auto;
                bottom: 240px;
                right: 50%;
                transform: translateX(50%);
                width: 90%;
            }
            .top-bar {
                flex-direction: column;
                gap: 10px;
            }
            .quote-text {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body data-theme="punjab">

    <div id="viewport">
        <!-- Parallax Background Layers -->
        <div class="layer" id="layer-sky">
            <div class="sun"></div>
        </div>

        <div class="layer" id="layer-landscape">
            <!-- Dynamic Silhouette Canvas -->
            <svg class="silhouette" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M0,120 L0,90 Q150,60 300,95 T600,85 T900,100 T1200,80 L1200,120 Z" fill="#120803" />
                <path d="M0,120 L0,100 Q200,80 400,105 T800,90 T1200,95 L1200,120 Z" fill="#000" opacity="0.5" />
            </svg>
        </div>

        <div class="layer" id="layer-fields">
            <div class="farm-fields">
                <div class="furrows" id="furrows"></div>
            </div>
        </div>

        <!-- Heat Haze Overlay -->
        <div class="heat-haze"></div>

        <!-- Nostalgic Village Quotes -->
        <div class="quote-container">
            <div class="quote-text" id="quote-text">"ਮਿੱਟੀ ਦੀ ਖੁਸ਼ਬੂ ਤੇ ਖੇਤਾਂ ਦੀ ਸ਼ਾਨ..."</div>
            <div class="quote-sub" id="quote-sub">Soul of Rural Punjab</div>
        </div>

        <!-- Top Navigation / Controls Bar -->
        <header class="top-bar">
            <div class="brand-logo">
                <i class="fa-solid fa-tractor" style="color: var(--accent-gold); font-size: 1.5rem;"></i>
                <div>
                    <h1>ਕਿਸਾਨ Swaraj</h1>
                    <span>VILLAGE COCKPIT SIMULATOR</span>
                </div>
            </div>

            <div class="selector-group">
                <select class="glass-select" id="theme-select" title="Select State Theme">
                    <option value="punjab">🌾 Punjab - Wheat Golden Fields</option>
                    <option value="rajasthan">🏜️ Rajasthan - Crimson Dunes</option>
                    <option value="kerala">🌴 Kerala - Coconut Backwaters</option>
                    <option value="up">🎋 Uttar Pradesh - Sugarcane Lush</option>
                </select>

                <select class="glass-select" id="tractor-select" title="Select Tractor Model">
                    <option value="mahindra">🚜 Mahindra 575 DI (Swaraj Red)</option>
                    <option value="eicher">🚜 Classic Eicher 242 (Vintage NC)</option>
                    <option value="farmtrac">🚜 Farmtrac 6060 (Executive Blue)</option>
                </select>
            </div>
        </header>

        <!-- Glassmorphism Music Player -->
        <div class="music-player-card">
            <div class="player-header">
                <h3><i class="fa-solid fa-radio"></i> Desi Beats FM</h3>
                <span style="font-size: 0.7rem; color:#888; background:rgba(255,255,255,0.1); padding:2px 8px; border-radius:10px;">LIVE</span>
            </div>
            <div class="track-info">
                <div class="track-title" id="track-title">Pind De Morh Te - Folk Mix</div>
                <div class="track-artist" id="track-artist">Village Stereo Master</div>
            </div>
            <div class="progress-area" id="progress-container">
                <div class="progress-bar" id="progress-bar"></div>
            </div>
            <div class="player-controls">
                <button class="control-btn" id="prev-btn" title="Previous Track"><i class="fa-solid fa-backward-step"></i></button>
                <button class="control-btn play-btn" id="play-btn" title="Play/Pause"><i class="fa-solid fa-play" id="play-icon"></i></button>
                <button class="control-btn" id="next-btn" title="Next Track"><i class="fa-solid fa-forward-step"></i></button>
            </div>
            <div class="playlist-box" id="playlist-box">
                <!-- Tracks dynamically injected -->
            </div>
        </div>

        <!-- Central Tractor Cockpit & Interactive Hood -->
        <div class="cockpit-container">
            <div class="exhaust-stack">
                <div class="smoke-particle" id="smoke-1"></div>
                <div class="smoke-particle" id="smoke-2"></div>
                <div class="smoke-particle" id="smoke-3"></div>
            </div>

            <!-- Vector Tractor Hood Graphic -->
            <div class="tractor-body" id="tractor-body">
                <svg class="hood-svg" viewBox="0 0 800 250" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Hood Main Base -->
                    <path id="hood-main" d="M150 250 L200 80 L600 80 L650 250 Z" fill="#D62828" stroke="#111" stroke-width="4"/>
                    <!-- Hood Top Ridge -->
                    <path id="hood-top" d="M200 80 L250 20 L550 20 L600 80 Z" fill="#B21E1E" />
                    <!-- Front Grill -->
                    <rect x="300" y="100" width="200" height="110" rx="8" fill="#1A1A1A" stroke="#333" stroke-width="3"/>
                    <!-- Grill Slats -->
                    <line x1="320" y1="120" x2="480" y2="120" stroke="#444" stroke-width="4"/>
                    <line x1="320" y1="140" x2="480" y2="140" stroke="#444" stroke-width="4"/>
                    <line x1="320" y1="160" x2="480" y2="160" stroke="#444" stroke-width="4"/>
                    <line x1="320" y1="180" x2="480" y2="180" stroke="#444" stroke-width="4"/>
                    <!-- Chrome Emblem -->
                    <circle cx="400" cy="50" r="18" fill="url(#chrome-grad)" stroke="#fff" stroke-width="2"/>
                    <!-- Dual Headlights -->
                    <circle cx="250" cy="140" r="22" fill="#FFFFE0" stroke="#555" stroke-width="4"/>
                    <circle cx="250" cy="140" r="14" fill="#FFF" id="headlight-left" opacity="0.6"/>
                    <circle cx="550" cy="140" r="22" fill="#FFFFE0" stroke="#555" stroke-width="4"/>
                    <circle cx="550" cy="140" r="14" fill="#FFF" id="headlight-right" opacity="0.6"/>

                    <defs>
                        <linearGradient id="chrome-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#E0E0E0"/>
                            <stop offset="50%" stop-color="#888888"/>
                            <stop offset="100%" stop-color="#FFFFFF"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>

            <!-- HUD Dashboard Container -->
            <div class="hud-dashboard">
                <!-- Left Gauges -->
                <div class="gauge-cluster">
                    <div class="gauge-card">
                        <svg class="gauge-svg" viewBox="0 0 100 100">
                            <circle class="gauge-bg" cx="50" cy="50" r="45"/>
                            <circle class="gauge-val" id="fuel-gauge" cx="50" cy="50" r="45"/>
                        </svg>
                        <div class="gauge-center">
                            <div class="gauge-num" id="fuel-val">85%</div>
                            <div class="gauge-label">DIESEL</div>
                        </div>
                    </div>
                </div>

                <!-- Center Ignition & Controls -->
                <div class="center-controls">
                    <button class="ignition-btn" id="ignition-btn" title="Start Engine Ignition">
                        <i class="fa-solid fa-power-off ignition-icon"></i>
                    </button>

                    <div class="action-btns">
                        <button class="btn-action" id="horn-btn"><i class="fa-solid fa-bullhorn"></i> HORN</button>
                        <button class="btn-action" id="lights-btn"><i class="fa-solid fa-lightbulb"></i> LIGHTS</button>
                    </div>
                </div>

                <!-- Right Gauges -->
                <div class="gauge-cluster">
                    <div class="gauge-card">
                        <svg class="gauge-svg" viewBox="0 0 100 100">
                            <circle class="gauge-bg" cx="50" cy="50" r="45"/>
                            <circle class="gauge-val" id="rpm-gauge" cx="50" cy="50" r="45"/>
                        </svg>
                        <div class="gauge-center">
                            <div class="gauge-num" id="rpm-val">0</div>
                            <div class="gauge-label">RPM x100</div>
                        </div>
                    </div>

                    <div class="gauge-card">
                        <svg class="gauge-svg" viewBox="0 0 100 100">
                            <circle class="gauge-bg" cx="50" cy="50" r="45"/>
                            <circle class="gauge-val" id="speed-gauge" cx="50" cy="50" r="45"/>
                        </svg>
                        <div class="gauge-center">
                            <div class="gauge-num" id="speed-val">0</div>
                            <div class="gauge-label">KM/H</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Logic Script -->
    <script>
        // --- State Management & Configuration ---
        const stateThemes = {
            punjab: {
                quote: '"ਮਿੱਟੀ ਦੀ ਖੁਸ਼ਬੂ ਤੇ ਖੇਤਾਂ ਦੀ ਸ਼ਾਨ..."',
                sub: 'Soul of Golden Punjab',
                soil: '#3d1c02',
                dustColor: 'rgba(255, 200, 100, 0.5)'
            },
            rajasthan: {
                quote: '"ਪਧਾਰੋ ਮ੍ਹਾਰੇ ਦੇਸ - Golden Sand Dunes..."',
                sub: 'Majestic Rajasthan Plains',
                soil: '#6b3e26',
                dustColor: 'rgba(231, 111, 81, 0.5)'
            },
            kerala: {
                quote: '"God\'s Own Country - Green Horizon..."',
                sub: 'Lush Kerala Coconut Groves',
                soil: '#14532d',
                dustColor: 'rgba(16, 185, 129, 0.5)'
            },
            up: {
                quote: '"ਗੰਨੇ ਦੇ ਖੇਤ ਤੇ ਪਿੰਡ ਦੀਆਂ ਰਾਹਾਂ..."',
                sub: 'Heartland Sugarcane Fields - UP',
                soil: '#4a1d96',
                dustColor: 'rgba(192, 132, 252, 0.5)'
            }
        };

        const tractorModels = {
            mahindra: {
                hoodMain: '#D62828',
                hoodTop: '#B21E1E',
                name: 'Mahindra 575 DI'
            },
            eicher: {
                hoodMain: '#C1121F',
                hoodTop: '#780000',
                name: 'Classic Eicher 242'
            },
            farmtrac: {
                hoodMain: '#0077B6',
                hoodTop: '#023E8A',
                name: 'Farmtrac 6060 Executive'
            }
        };

        const playlist = [
            { title: "Pind De Morh Te", artist: "Folk Legends", duration: "3:45" },
            { title: "Swaraj Aala Tractor", artist: "Desi Village Beats", duration: "4:12" },
            { title: "Khetan Di Khushboo", artist: "Bhangra Sound System", duration: "3:20" },
            { title: "Majhe Di Jatti & Tractor", artist: "Punjab Acoustic", duration: "3:55" }
        ];

        // --- Application State ---
        let isEngineRunning = false;
        let isLightsOn = false;
        let isPlayingMusic = false;
        let currentTrackIdx = 0;
        let engineAudioCtx = null;
        let engineOscillator = null;
        let engineGain = null;
        let audioInterval = null;
        let rpmVal = 0;
        let speedVal = 0;

        // --- DOM Elements ---
        const body = document.body;
        const themeSelect = document.getElementById('theme-select');
        const tractorSelect = document.getElementById('tractor-select');
        const ignitionBtn = document.getElementById('ignition-btn');
        const hornBtn = document.getElementById('horn-btn');
        const lightsBtn = document.getElementById('lights-btn');
        const headlightLeft = document.getElementById('headlight-left');
        const headlightRight = document.getElementById('headlight-right');
        const furrows = document.getElementById('furrows');
        const tractorBody = document.getElementById('tractor-body');
        const hoodMain = document.getElementById('hood-main');
        const hoodTop = document.getElementById('hood-top');

        const rpmGauge = document.getElementById('rpm-gauge');
        const rpmNum = document.getElementById('rpm-val');
        const speedGauge = document.getElementById('speed-gauge');
        const speedNum = document.getElementById('speed-val');
        const fuelGauge = document.getElementById('fuel-gauge');

        const quoteText = document.getElementById('quote-text');
        const quoteSub = document.getElementById('quote-sub');

        // Music DOM
        const playBtn = document.getElementById('play-btn');
        const playIcon = document.getElementById('play-icon');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const trackTitle = document.getElementById('track-title');
        const trackArtist = document.getElementById('track-artist');
        const progressBar = document.getElementById('progress-bar');
        const progressContainer = document.getElementById('progress-container');
        const playlistBox = document.getElementById('playlist-box');

        // Initialize Fuel Gauge Static Level (85%)
        fuelGauge.style.strokeDashoffset = 283 - (283 * 0.85);

        // --- Web Audio API Engine & Horn Synthesizer ---
        function initAudioContext() {
            if (!engineAudioCtx) {
                engineAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function startEngineSound() {
            initAudioContext();
            if (engineAudioCtx.state === 'suspended') {
                engineAudioCtx.resume();
            }

            // Engine Low Frequency Vibration Oscillator
            engineOscillator = engineAudioCtx.createOscillator();
            engineGain = engineAudioCtx.createGain();

            engineOscillator.type = 'sawtooth';
            engineOscillator.frequency.setValueAtTime(35, engineAudioCtx.currentTime); // Low idle rumble

            // Lowpass Filter for Deep Mechanical Thump
            const filter = engineAudioCtx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(160, engineAudioCtx.currentTime);

            engineOscillator.connect(filter);
            filter.connect(engineGain);
            engineGain.connect(engineAudioCtx.destination);

            engineGain.gain.setValueAtTime(0.01, engineAudioCtx.currentTime);
            engineGain.gain.exponentialRampToValueAtTime(0.18, engineAudioCtx.currentTime + 0.8);

            engineOscillator.start();
        }

        function stopEngineSound() {
            if (engineGain) {
                engineGain.gain.exponentialRampToValueAtTime(0.001, engineAudioCtx.currentTime + 0.5);
                setTimeout(() => {
                    if (engineOscillator) {
                        engineOscillator.stop();
                        engineOscillator.disconnect();
                    }
                }, 500);
            }
        }

        function playHornSound() {
            initAudioContext();
            if (engineAudioCtx.state === 'suspended') {
                engineAudioCtx.resume();
            }

            // Authentic Dual-Tone Indian Horn Synthesizer
            const osc1 = engineAudioCtx.createOscillator();
            const osc2 = engineAudioCtx.createOscillator();
            const hornGain = engineAudioCtx.createGain();

            osc1.type = 'sawtooth';
            osc2.type = 'sawtooth';

            osc1.frequency.setValueAtTime(420, engineAudioCtx.currentTime); // High pitch
            osc2.frequency.setValueAtTime(340, engineAudioCtx.currentTime); // Low pitch

            hornGain.gain.setValueAtTime(0.25, engineAudioCtx.currentTime);
            hornGain.gain.exponentialRampToValueAtTime(0.01, engineAudioCtx.currentTime + 0.6);

            osc1.connect(hornGain);
            osc2.connect(hornGain);
            hornGain.connect(engineAudioCtx.destination);

            osc1.start();
            osc2.start();
            osc1.stop(engineAudioCtx.currentTime + 0.6);
            osc2.stop(engineAudioCtx.currentTime + 0.6);
        }

        // --- Ignition Logic ---
        ignitionBtn.addEventListener('click', () => {
            isEngineRunning = !isEngineRunning;

            if (isEngineRunning) {
                ignitionBtn.classList.add('active');
                startEngineSound();
                furrows.style.animationPlayState = 'running';
                
                // Animate Dashboard Gauges Up
                gsap.to({ rpm: 0, speed: 0 }, {
                    rpm: 22,
                    speed: 18,
                    duration: 1.5,
                    onUpdate: function() {
                        rpmVal = Math.round(this.targets()[0].rpm);
                        speedVal = Math.round(this.targets()[0].speed);
                        
                        rpmNum.innerText = rpmVal;
                        speedNum.innerText = speedVal;

                        rpmGauge.style.strokeDashoffset = 283 - (283 * (rpmVal / 30));
                        speedGauge.style.strokeDashoffset = 283 - (283 * (speedVal / 40));
                    }
                });

                // Cockpit Rumble Animation
                gsap.to(tractorBody, {
                    y: "+=2",
                    duration: 0.08,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut"
                });

                // Smoke Exhaust Particles
                triggerSmokeParticles();
            } else {
                ignitionBtn.classList.remove('active');
                stopEngineSound();
                furrows.style.animationPlayState = 'paused';

                // Reset Gauges
                gsap.to({ rpm: rpmVal, speed: speedVal }, {
                    rpm: 0,
                    speed: 0,
                    duration: 1,
                    onUpdate: function() {
                        const r = Math.round(this.targets()[0].rpm);
                        const s = Math.round(this.targets()[0].speed);
                        rpmNum.innerText = r;
                        speedNum.innerText = s;

                        rpmGauge.style.strokeDashoffset = 283 - (283 * (r / 30));
                        speedGauge.style.strokeDashoffset = 283 - (283 * (s / 40));
                    }
                });

                gsap.killTweensOf(tractorBody);
                gsap.to(tractorBody, { y: 0, duration: 0.3 });
            }
        });

        // --- Exhaust Smoke Particles Animation ---
        function triggerSmokeParticles() {
            if (!isEngineRunning) return;

            const particles = [document.getElementById('smoke-1'), document.getElementById('smoke-2'), document.getElementById('smoke-3')];
            particles.forEach((p, idx) => {
                gsap.fromTo(p, 
                    { y: 0, opacity: 0.7, scale: 0.5 }, 
                    {
                        y: -80 - (idx * 20),
                        x: "+=" + (Math.random() * 40 - 20),
                        opacity: 0,
                        scale: 2.5,
                        duration: 1.5 + (idx * 0.3),
                        repeat: -1,
                        delay: idx * 0.4,
                        ease: "power1.out"
                    }
                );
            });
        }

        // --- Horn & Lights Action Buttons ---
        hornBtn.addEventListener('click', () => {
            playHornSound();
            gsap.to(tractorBody, { scale: 1.02, duration: 0.1, yoyo: true, repeat: 1 });
        });

        lightsBtn.addEventListener('click', () => {
            isLightsOn = !isLightsOn;
            if (isLightsOn) {
                headlightLeft.setAttribute('fill', '#FFFF00');
                headlightRight.setAttribute('fill', '#FFFF00');
                headlightLeft.style.filter = "drop-shadow(0 0 15px #FFFF00)";
                headlightRight.style.filter = "drop-shadow(0 0 15px #FFFF00)";
                lightsBtn.style.boxShadow = "0 0 15px var(--accent-gold)";
            } else {
                headlightLeft.setAttribute('fill', '#FFF');
                headlightRight.setAttribute('fill', '#FFF');
                headlightLeft.style.filter = "none";
                headlightRight.style.filter = "none";
                lightsBtn.style.boxShadow = "none";
            }
        });

        // --- Theme Engine Switcher ---
        themeSelect.addEventListener('change', (e) => {
            const key = e.target.value;
            body.setAttribute('data-theme', key);

            // Update Nostalgic Quote
            const themeData = stateThemes[key];
            gsap.to([quoteText, quoteSub], {
                opacity: 0,
                y: -10,
                duration: 0.4,
                onComplete: () => {
                    quoteText.innerText = themeData.quote;
                    quoteSub.innerText = themeData.sub;
                    gsap.to([quoteText, quoteSub], { opacity: 1, y: 0, duration: 0.6 });
                }
            });
        });

        // --- Tractor Model Configurator ---
        tractorSelect.addEventListener('change', (e) => {
            const model = tractorModels[e.target.value];
            gsap.to(hoodMain, { fill: model.hoodMain, duration: 0.5 });
            gsap.to(hoodTop, { fill: model.hoodTop, duration: 0.5 });
        });

        // --- Interactive Parallax Effect ---
        window.addEventListener('mousemove', (e) => {
            const xVal = (e.clientX / window.innerWidth - 0.5) * 30;
            const yVal = (e.clientY / window.innerHeight - 0.5) * 15;

            gsap.to('#layer-sky', { x: xVal * 0.2, y: yVal * 0.2, duration: 0.5 });
            gsap.to('#layer-landscape', { x: xVal * 0.5, y: yVal * 0.5, duration: 0.5 });
            gsap.to('#layer-fields', { x: xVal * 0.8, y: yVal * 0.8, duration: 0.5 });
        });

        // --- Glassmorphism Music Player Implementation ---
        function renderPlaylist() {
            playlistBox.innerHTML = '';
            playlist.forEach((track, idx) => {
                const item = document.createElement('div');
                item.className = `playlist-item ${idx === currentTrackIdx ? 'active' : ''}`;
                item.innerHTML = `
                    <span>${idx + 1}. ${track.title}</span>
                    <span>${track.duration}</span>
                `;
                item.addEventListener('click', () => {
                    currentTrackIdx = idx;
                    loadTrack(currentTrackIdx);
                    playMusic();
                });
                playlistBox.appendChild(item);
            });
        }

        function loadTrack(idx) {
            const track = playlist[idx];
            trackTitle.innerText = track.title;
            trackArtist.innerText = track.artist;
            progressBar.style.width = '0%';
            renderPlaylist();
        }

        let musicProgressInterval = null;
        let progressPercent = 0;

        function playMusic() {
            isPlayingMusic = true;
            playIcon.className = 'fa-solid fa-pause';
            if (musicProgressInterval) clearInterval(musicProgressInterval);

            musicProgressInterval = setInterval(() => {
                progressPercent += 0.5;
                if (progressPercent > 100) {
                    progressPercent = 0;
                    nextTrack();
                }
                progressBar.style.width = `${progressPercent}%`;
            }, 300);
        }

        function pauseMusic() {
            isPlayingMusic = false;
            playIcon.className = 'fa-solid fa-play';
            if (musicProgressInterval) clearInterval(musicProgressInterval);
        }

        playBtn.addEventListener('click', () => {
            if (isPlayingMusic) {
                pauseMusic();
            } else {
                playMusic();
            }
        });

        function nextTrack() {
            currentTrackIdx = (currentTrackIdx + 1) % playlist.length;
            progressPercent = 0;
            loadTrack(currentTrackIdx);
            if (isPlayingMusic) playMusic();
        }

        function prevTrack() {
            currentTrackIdx = (currentTrackIdx - 1 + playlist.length) % playlist.length;
            progressPercent = 0;
            loadTrack(currentTrackIdx);
            if (isPlayingMusic) playMusic();
        }

        nextBtn.addEventListener('click', nextTrack);
        prevBtn.addEventListener('click', prevTrack);

        progressContainer.addEventListener('click', (e) => {
            const width = progressContainer.clientWidth;
            const clickX = e.offsetX;
            progressPercent = (clickX / width) * 100;
            progressBar.style.width = `${progressPercent}%`;
        });

        // --- Atmospheric Floating Dust Particles ---
        function createDustParticles() {
            const viewport = document.getElementById('viewport');
            for (let i = 0; i < 25; i++) {
                const particle = document.createElement('div');
                particle.className = 'dust-particle';
                const size = Math.random() * 4 + 2;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                particle.style.left = `${Math.random() * 100}%`;
                particle.style.top = `${Math.random() * 100}%`;
                particle.style.opacity = Math.random() * 0.6;
                viewport.appendChild(particle);

                gsap.to(particle, {
                    y: "-=" + (Math.random() * 100 + 50),
                    x: "+=" + (Math.random() * 60 - 30),
                    duration: Math.random() * 5 + 5,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut"
                });
            }
        }

        // --- Init App ---
        loadTrack(currentTrackIdx);
        createDustParticles();

        // Initial Quote Fade In
        gsap.to([quoteText, quoteSub], { opacity: 1, y: 0, duration: 1.2, delay: 0.5 });
    </script>
</body>
</html>
